{
  "manifest_version": 3,
  "name": "Zping 简历投递助手",
  "version": "1.4.0",
  "description": "在 Boss直聘、鱼泡网按条件筛选职位，每次投递前确认公司、岗位、地点、薪资和学历。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://*.zhipin.com/*",
    "https://www.yupao.com/*",
    "https://*.yupao.com/*"
  ],
  "action": {
    "default_title": "Zping 简历投递助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*", "https://*.zhipin.com/*"],
      "js": ["content/inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.zhipin.com/*", "https://*.zhipin.com/*"],
      "js": ["lib/cities.js", "lib/storage-queue.js", "lib/history.js", "lib/greeting.js", "lib/xlsx.bundle.js", "lib/zping-export.js", "content/common.js", "content/boss.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://www.yupao.com/*", "https://*.yupao.com/*"],
      "js": ["lib/cities.js", "lib/storage-queue.js", "lib/history.js", "lib/greeting.js", "lib/xlsx.bundle.js", "lib/zping-export.js", "content/common.js", "content/yupao.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
